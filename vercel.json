{
  "version": 2,
  "buildCommand": "node scripts/set-api-url.js && npm run build",
  "outputDirectory": "dist/hambox/browser",
  "framework": null,
  "rewrites": [
    { "source": "/api/:path*", "destination": "http://hambox.runasp.net/api/:path*" },
    { "source": "/uploads/:path*", "destination": "http://hambox.runasp.net/uploads/:path*" },
    { "source": "/health", "destination": "http://hambox.runasp.net/health" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
